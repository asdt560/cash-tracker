<nav class='navbar'>
  <%= link_to "<", categories_path %>
  <h2>Transactions - <%= @category.name %></h2>
</nav>
<main class="container three">
    <div class="total">
      <p>Total:</p>
      <%= turbo_frame_tag "total" do %>
        <%= render(partial: 'total', locals: { category: @category }, formats: [:html]) %>
      <% end %>
    </div>
  <%= render 'cards' %>
  <div class="greenbuttondiv">
    <%= link_to "ADD A NEW TRANSACTION", new_category_payment_path, class: "greenbutton" %>
  </div>
</main>
