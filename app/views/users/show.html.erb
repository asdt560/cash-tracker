<nav class='navbar'>
  <%= link_to "<", :back %>
  <h2>Profile - <%= @user.name %></h2>
</nav>
<div class='container'>
  <p>Total Payments: <%= number_to_currency(@total_payments.fdiv(100)) %></p>
  <%= turbo_frame_tag "pending" do %>
    <%= render(partial: 'pending', locals: { pending_payments: @pending_payments }, formats: [:html]) %>
  <% end %>
  <%= button_to "Pay All Pending", user_payall_path(@user.id), method: :put, class: 'btn btn-primary' %>
  <%= link_to 'Edit User', edit_user_registration_path %>
</div>